DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=
COUNTRY=brasil
EJ_THEME=ej
HOSTNAME=localhost
PYTHONUNBUFFERED=1
DB_HOST=db
DJANGO_SECRET_KEY=
DISABLE_DJANGO_DEBUG_TOOLBAR=False
ENVIRONMENT=local
DJANGO_DEBUG=True

# Anymail Mailgun keys
# https://anymail.dev/en/stable/
MAILGUN_API_KEY=
MAILGUN_SENDER_DOMAIN=

# Django Core Mail
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# RabbitMQ Credentials
RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=password

JWT_SECRET=

# GOV.BR Login Unico
# Keep disabled until GOV.BR approves the credentials and both URLs.
GOVBR_ENABLED=False
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=
GOVBR_SUBJECT_HASH_KEY=
GOVBR_REDIRECT_URI=
GOVBR_POST_LOGOUT_REDIRECT_URI=
GOVBR_AUTHORIZE_URL=https://sso.staging.acesso.gov.br/authorize
GOVBR_TOKEN_URL=https://sso.staging.acesso.gov.br/token
GOVBR_JWKS_URL=https://sso.staging.acesso.gov.br/jwk
GOVBR_LOGOUT_URL=https://sso.staging.acesso.gov.br/logout
GOVBR_ISSUER=https://sso.staging.acesso.gov.br/

# set this variable to "api" if you want to
# disable assets compilation in the production environment.
SERVER_MODE=web

# set this variable to "False" if you don't want the user
# voting again in comments he already skiped.
# You can edit this value in Django admin, in the Constance page.
RETURN_USER_SKIPED_COMMENTS=True
