<!doctype html>
<html>
  <head>
    <meta charset="utf-8">
  </head>
  <body>
    <p>{% trans %}{{ owner_username }} invited you to collaborate on the board <strong>{{ board_title }}</strong> on the Empurrando Juntos platform.{% endtrans %}</p>

    <p>{% trans %}By accepting this invitation, you will have access to the board and will be able to manage its conversations, according to the permissions granted.{% endtrans %}</p>

    <p>{% trans %}To accept the invitation, click the link below:{% endtrans %}</p>

    <p><a href="{{ accept_url }}">{{ accept_url }}</a></p>

    <hr />

    <p>{% trans %}Run opinion polls with Empurrando Juntos and understand how your audience positions itself on a wide range of topics.{% endtrans %}</p>

    <p>{{ site_domain }}</p>
  </body>
</html>
